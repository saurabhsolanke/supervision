// Prisma Multi-Tenant Schema for    DevOps Boards SaaS
// Inspired by       DevOps multi-tenant architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // Pooled connection (port 6543)
  directUrl = env("DIRECT_URL")     // Direct connection (port 5432)
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum PlanTier {
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

enum WorkItemType {
  USER_STORY
  TASK
  BUG
  FEATURE
  EPIC
}

enum WorkItemState {
  NEW
  ACTIVE
  RESOLVED
  CLOSED
}

enum Priority {
  P1_CRITICAL
  P2_HIGH
  P3_MEDIUM
  P4_LOW
}

/// Tenant Root Entity
/// All core business entities are partitioned by organization_id to guarantee data isolation.
/// PostgreSQL Row Level Security (RLS) policy:
/// CREATE POLICY tenant_isolation_policy ON "WorkItem"
///   USING (organization_id = NULLIF(current_setting('app.current_organization_id', true), '')::text);
model Organization {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // SaaS Commercial & Billing Layer
  subscription Subscription?

  // Tenant Membership
  memberships OrganizationMembership[]
  invitations TenantInvitation[]

  // Core Multi-Tenant Hierarchy
  workspaces  Workspace[]
  projects    Project[]
  workItems   WorkItem[]
  columns     BoardColumn[]
  auditLogs   AuditLog[]

  @@index([slug])
}

model Subscription {
  id                   String             @id @default(uuid())
  organizationId       String             @unique
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planTier             PlanTier           @default(PRO)
  status               SubscriptionStatus @default(ACTIVE)
  seatCount            Int                @default(1)
  maxSeats             Int                @default(10)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime
  billingCycle         String             @default("monthly") // monthly | annual
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([organizationId])
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  passwordHash  String?
  avatarUrl     String?
  jobTitle      String?
  isSuperAdmin  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships       OrganizationMembership[]
  assignedWorkItems WorkItem[]               @relation("WorkItemAssignee")
  reportedWorkItems WorkItem[]               @relation("WorkItemReporter")
  comments          WorkItemComment[]
  auditLogs         AuditLog[]

  @@index([email])
}

/// Tenant Membership with Role-Based Access Control (RBAC)
model OrganizationMembership {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @default(MEMBER)
  joinedAt       DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model TenantInvitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role         @default(MEMBER)
  invitedBy      String
  token          String       @unique
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
}

/// Hierarchy: Workspace -> Projects
model Workspace {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  projects Project[]

  @@index([organizationId])
}

/// Project / App within Workspace
model Project {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  key            String       // e.g. "AZP", "CORE"
  description    String?
  icon           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  columns   BoardColumn[]
  sprints   Sprint[]
  workItems WorkItem[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([workspaceId])
}

/// Kanban Board Column with Custom WIP limits
model BoardColumn {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String        // "New", "Active", "Resolved", "Closed"
  state          WorkItemState
  order          Int           @default(0)
  wipLimit       Int?          // Work-In-Progress limit (null = unlimited)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workItems WorkItem[]

  @@index([organizationId])
  @@index([projectId])
}

model Sprint {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String    // "Sprint 34", "Sprint 35"
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workItems WorkItem[]

  @@index([projectId])
}

/// Work Item entity matching    DevOps Boards schema
model WorkItem {
  id                 String          @id @default(uuid())
  itemNumber         Int             // Sequential human-readable ID e.g. 1024 (AB#1024)
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId          String
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columnId           String
  column             BoardColumn     @relation(fields: [columnId], references: [id], onDelete: Cascade)
  sprintId           String?
  sprint             Sprint?         @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  type               WorkItemType    @default(USER_STORY)
  state              WorkItemState   @default(NEW)
  priority           Priority        @default(P3_MEDIUM)
  title              String
  description        String?         @db.Text
  acceptanceCriteria String?         @db.Text
  effort             Int?            @default(3) // Story points / effort estimation
  order              Int             @default(0) // Ordering within column
  tags               String[]        @default([])

  assigneeId         String?
  assignee           User?           @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId         String
  reporter           User            @relation("WorkItemReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  comments           WorkItemComment[]

  @@unique([organizationId, itemNumber])
  @@index([organizationId])
  @@index([projectId])
  @@index([columnId])
  @@index([assigneeId])
  @@index([state])
  @@index([type])
}

model WorkItemComment {
  id         String   @id @default(uuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([workItemId])
  @@index([authorId])
}

/// Multi-Tenant Audit Log for compliance and security monitoring
model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String
  actor          User         @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action         String       // e.g. "WORK_ITEM_CREATED", "COLUMN_MOVED", "MEMBER_INVITED"
  entityType     String       // "WorkItem", "Subscription", "Membership"
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([actorId])
  @@index([createdAt])
}
